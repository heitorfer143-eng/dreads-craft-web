extends RefCounted

const PICK_WOOD=""
const PICK_STONE=""
const PICK_IRON=""
const PICK_DIAMOND=""

static func texture_from_b64(data: String) -> Texture2D:
	var image=Image.new()
	var err=image.load_png_from_buffer(Marshalls.base64_to_raw(data))
	if err!=OK:
		return null
	return ImageTexture.create_from_image(image)

static func pickaxe(id: int) -> Texture2D:
	match id:
		13: return texture_from_b64(PICK_WOOD)
		17: return texture_from_b64(PICK_STONE)
		18: return texture_from_b64(PICK_IRON)
		19: return texture_from_b64(PICK_DIAMOND)
	return null
